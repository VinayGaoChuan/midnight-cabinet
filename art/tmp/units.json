[{"k":"RedWorm","n":"赤蠕虫","type":"Summon","race":"兽人","voc":"商人","q":0,"ranged":0,"desc":"十分脆弱的高伤害单位。"},{"k":"SickleWorm","n":"镰刃虫","type":"Summon","race":"兽人","voc":"商人","q":0,"ranged":0,"desc":"能让其不防守而去外出寻宝获得额外秘晶。"},{"k":"Ronin","n":"浪人","type":"Summon","race":"兽人","voc":"射手","q":0,"ranged":1,"desc":"飞行单位。根据移动距离增加攻速。"},{"k":"MadMonarch","n":"狂王","type":"Summon","race":"兽人","voc":"射手","q":2,"ranged":1,"desc":"飞行单位。每次攻击时增加攻击速度。"},{"k":"Troll","n":"巨魔","type":"Summon","race":"兽人","voc":"商人","q":0,"ranged":0,"desc":"根据升级路径能选择更适于建造在更强或更弱的友方单位旁。"},{"k":"GreenDemon","n":"绿魔","type":"Summon","race":"兽人","voc":"先锋","q":2,"ranged":0,"desc":"强大的单位。附近有更高战斗力的单位时会变弱。"},{"k":"YellowDemon","n":"黄魔","type":"Summon","race":"兽人","voc":"战士","q":2,"ranged":0,"desc":"附近建造更高战斗力的单位时会获得加强。"},{"k":"DesertBeliever","n":"沙漠信徒","type":"Summon","race":"兽人","voc":"祭司","q":1,"ranged":1,"desc":"使用治疗链治疗多个友方单位。"},{"k":"SnakeGodMessenger","n":"蛇神使者","type":"Summon","race":"兽人","voc":"祭司","q":3,"ranged":1,"desc":"使用大地之灵祝福友方单位，增加其最大生命值。"},{"k":"MagicShieldSoldier","n":"魔盾兵","type":"Summon","race":"兽人","voc":"先锋","q":2,"ranged":0,"desc":"重装单位。但是不以攻击力著称。"},{"k":"AntiMagicGuardian","n":"破魔守卫","type":"Summon","race":"兽人","voc":"先锋","q":3,"ranged":0,"desc":"究极奥术护甲重装单位。"},{"k":"BigWildBoar","n":"巨型野猪","type":"Summon","race":"兽人","voc":"先锋","q":2,"ranged":0,"desc":"重装单位。能冲锋进入战场造成溅射伤害"},{"k":"RedEyes","n":"赤瞳","type":"Summon","race":"兽人","voc":"先锋","q":3,"ranged":0,"desc":"拥有更高的坦度以及更狂躁的冲锋。"},{"k":"Chick","n":"雏鸡","type":"Summon","race":"不死","voc":"商人","q":0,"ranged":1,"desc":"飞行单位。能升级为两种不同的形态。"},{"k":"Turkey","n":"火鸡","type":"Summon","race":"不死","voc":"商人","q":1,"ranged":1,"desc":"飞行单位。远程伤害单位。能转换成近战防御形态的恶魔鱼"},{"k":"Rooster","n":"公鸡","type":"Summon","race":"不死","voc":"商人","q":1,"ranged":0,"desc":"飞行单位。近战重装单位。可以适应为塞拉芬。"},{"k":"FootSoldier","n":"步卒","type":"Summon","race":"不死","voc":"战士","q":0,"ranged":0,"desc":"敌人死亡时积攒层数。层数越多最终升级形态越强。"},{"k":"RedCross","n":"赤十字","type":"Summon","race":"不死","voc":"战士","q":2,"ranged":0,"desc":"更加娴熟的渔夫。可以积攒更多的层数。"},{"k":"EmperorOfFlame","n":"炎帝","type":"Summon","race":"不死","voc":"战士","q":3,"ranged":0,"desc":"层数越多，伤害越高。但是将不再积攒新的层数。"},{"k":"WaterWarrior","n":"水战士","type":"Summon","race":"不死","voc":"战士","q":1,"ranged":0,"desc":"每波开始时遁地。在五秒后会破土而出，推荐建造于前线。"},{"k":"ImmortalBlueDemon","n":"不朽蓝魔","type":"Summon","race":"不死","voc":"战士","q":2,"ranged":0,"desc":"可以造成大量伤害但是十分脆弱。"},{"k":"Ogre","n":"食人魔","type":"Summon","race":"不死","voc":"商人","q":1,"ranged":0,"desc":"格拉尔秘制烤肉让其能以较高的价格出售"},{"k":"Commander","n":"指挥官","type":"Summon","race":"不死","voc":"先锋","q":3,"ranged":0,"desc":"重装单位。能重击地面来减速敌人。"},{"k":"BrownBear","n":"棕熊","type":"Summon","race":"不死","voc":"祭司","q":3,"ranged":0,"desc":"光环单位。临近建造的单位获得缓慢生命恢复以及魔法抗性"},{"k":"IceAndSnowMage","n":"冰雪法师","type":"Summon","race":"不死","voc":"法师","q":2,"ranged":1,"desc":"能周期性自我治疗并使攻击速度变快。"},{"k":"Archmage","n":"大法师","type":"Summon","race":"不死","voc":"法师","q":3,"ranged":1,"desc":"拥有一定承伤能力的远程输出。"},{"k":"Stone","n":"神石","type":"Summon","race":"不死","voc":"战士","q":2,"ranged":2,"desc":"独特单位。无法移动或攻击，但是能反弹受到的伤害。在两波后进化为九头蛇，或者在被击碎后提前孵化为稍弱的形态。"},{"k":"GiantGodOfWar","n":"巨人战神","type":"Summon","race":"不死","voc":"先锋","q":3,"ranged":0,"desc":"每过一波会变强。死亡时会分裂成3个小型九头蛇。"},{"k":"Deserter","n":"逃兵","type":"Summon","race":"骷髅","voc":"先锋","q":0,"ranged":0,"desc":"被动恢复生命值。拥有三条升级路线使其可以适应多种情况。"},{"k":"Warrior","n":"骸骨武士","type":"Summon","race":"骷髅","voc":"先锋","q":1,"ranged":0,"desc":"唯一一个重装骷髅。生命值越低，生命恢复速度越快。"},{"k":"Mage","n":"骸骨法师","type":"Summon","race":"骷髅","voc":"祭司","q":1,"ranged":1,"desc":"可以为一名友方单位增加大量攻击速度。"},{"k":"Archer","n":"骸骨弓手","type":"Summon","race":"骷髅","voc":"法师","q":0,"ranged":1,"desc":"远程单位。在被动恢复生命值的基础上可以使用法力值射出燃烧箭造成额外伤害。"},{"k":"Guard","n":"守卫","type":"Summon","race":"骷髅","voc":"先锋","q":0,"ranged":0,"desc":"飞行单位。受到的伤害减少。"},{"k":"ChurchGuard","n":"教堂守卫","type":"Summon","race":"骷髅","voc":"先锋","q":2,"ranged":0,"desc":"不再是飞行单位。受到的伤害进一步减少。"},{"k":"Summoner","n":"召唤师","type":"Summon","race":"骷髅","voc":"法师","q":1,"ranged":0,"desc":"能召唤混沌猎犬作战。"},{"k":"CandyGirl","n":"糖果女孩","type":"Summon","race":"骷髅","voc":"法师","q":2,"ranged":0,"desc":"能召唤更加凶狠的地狱犬。"},{"k":"BloodKnight","n":"血骑士","type":"Summon","race":"骷髅","voc":"先锋","q":1,"ranged":0,"desc":"光环单位。临近建造的单位获得吸血和法术吸血。"},{"k":"LionHammer","n":"狮锤","type":"Summon","race":"骷髅","voc":"先锋","q":3,"ranged":0,"desc":"光环单位。拥有一个主动治疗技能且临近建造的单位获得吸血和法术吸血。"},{"k":"SwordDancer","n":"剑舞者","type":"Summon","race":"骷髅","voc":"商人","q":2,"ranged":0,"desc":"高伤害但是防御力较低。"},{"k":"PhantomDancer","n":"幻影舞者","type":"Summon","race":"骷髅","voc":"战士","q":3,"ranged":0,"desc":"每次攻击时收割敌人的能量都使其的镰刀更加强大。"},{"k":"Necromancer","n":"死灵法师","type":"Summon","race":"骷髅","voc":"法师","q":2,"ranged":1,"desc":"能召唤亡灵飞龙来吞噬敌人。"},{"k":"GrimReaper","n":"死神","type":"Summon","race":"骷髅","voc":"法师","q":3,"ranged":1,"desc":"召唤一只拥有无可匹敌力量的巨龙。敌方单位死亡时恢复法力值。"},{"k":"VikingWarrior","n":"维京战士","type":"Summon","race":"人类","voc":"商人","q":0,"ranged":0,"desc":"廉价的防御型单位"},{"k":"SlaveLord","n":"奴隶主","type":"Summon","race":"人类","voc":"先锋","q":1,"ranged":0,"desc":"重装单位。低生命值时攻击速度变快。"},{"k":"ShieldDefender","n":"持盾卫士","type":"Summon","race":"人类","voc":"先锋","q":0,"ranged":0,"desc":"重装单位。受到的远程伤害减少。"},{"k":"HeavilyArmedWarrior","n":"重装战士","type":"Summon","race":"人类","voc":"先锋","q":2,"ranged":0,"desc":"重装单位。受到的远程伤害减少。"},{"k":"YellowManeHorse","n":"黄鬃马","type":"Summon","race":"人类","voc":"祭司","q":0,"ranged":0,"desc":"为周围的友方单位恢复法力。"},{"k":"SweatBloodHorse","n":"汗血马","type":"Summon","race":"人类","voc":"祭司","q":2,"ranged":0,"desc":"虔诚的信仰增强了它的恢复能力。"},{"k":"EliteHunter","n":"精英猎手","type":"Summon","race":"人类","voc":"射手","q":1,"ranged":1,"desc":"每次攻击射出四发箭矢。"},{"k":"NightArcher","n":"暗夜射手","type":"Summon","race":"人类","voc":"射手","q":3,"ranged":1,"desc":"装备着劲弩，能射出五发箭矢。"},{"k":"PunishingCleric","n":"惩戒牧师","type":"Summon","race":"人类","voc":"射手","q":2,"ranged":1,"desc":"远程单位。攻击同一个敌人时伤害会慢慢增加。"},{"k":"Bishop","n":"主教","type":"Summon","race":"人类","voc":"射手","q":3,"ranged":1,"desc":"拥有逐渐提升伤害的远程单位。"},{"k":"GuardCommander","n":"卫队长","type":"Summon","race":"人类","voc":"法师","q":2,"ranged":0,"desc":"攻击或受到攻击时获得法力值。拥有的法力值越多越强大。"},{"k":"MarshalOrfa","n":"奥法元帅","type":"Summon","race":"人类","voc":"法师","q":3,"ranged":0,"desc":"即使千年已过，他的圣权仍固。"},{"k":"VoodooBeliever","n":"巫毒信徒","type":"Summon","race":"精灵","voc":"战士","q":0,"ranged":0,"desc":"飞行单位。死亡时会对击杀者施加毒素。"},{"k":"VoodooGuard","n":"巫毒守卫","type":"Summon","race":"精灵","voc":"战士","q":1,"ranged":0,"desc":"飞行单位。其爪子以及甲壳都让其战斗力更加强大。毒素浓度也得到了提升。"},{"k":"Ranger","n":"游侠","type":"Summon","race":"精灵","voc":"射手","q":0,"ranged":1,"desc":"远程单位。能增加首领单位受到的伤害"},{"k":"DeathShooter","n":"死亡射手","type":"Summon","race":"精灵","voc":"祭司","q":2,"ranged":1,"desc":"与人海战术以及攻速快的单位相性极佳。"},{"k":"RedGuard","n":"赤卫","type":"Summon","race":"精灵","voc":"先锋","q":1,"ranged":0,"desc":"波次开始时只有最大值一半的生命，但是能缓慢再生。"},{"k":"HolyLightKnight","n":"圣光骑士","type":"Summon","race":"精灵","voc":"先锋","q":2,"ranged":0,"desc":"飞行单位。成熟体的它伤害以及坦度都得到了提升。"},{"k":"EmeraldDragon","n":"翡翠龙","type":"Summon","race":"精灵","voc":"祭司","q":1,"ranged":0,"desc":"拥有能对周围敌人造成慢性伤害的香气"},{"k":"PoisonDragon","n":"毒龙","type":"Summon","race":"精灵","voc":"祭司","q":3,"ranged":0,"desc":"进化后的毒性更强了。"},{"k":"BlackIronGuard","n":"黑铁卫","type":"Summon","race":"精灵","voc":"先锋","q":2,"ranged":0,"desc":"重装单位。在怀特迈恩周围时更强。"},{"k":"VerdantShield","n":"翠盾","type":"Summon","race":"精灵","voc":"先锋","q":3,"ranged":0,"desc":"光环单位。临近建造的单位受到更少的伤害。"},{"k":"JadeVineFortress","n":"玉藤堡垒","type":"Summon","race":"精灵","voc":"先锋","q":2,"ranged":0,"desc":"重装远程单位。受到攻击时反弹伤害。"},{"k":"StormFortress","n":"风暴堡垒","type":"Summon","race":"精灵","voc":"先锋","q":3,"ranged":0,"desc":"能同时投掷3个香蕉，荆棘也能反弹更多伤害了。"},{"k":"Lizard","n":"蜥蜴","type":"Summon","race":"僵尸","voc":"射手","q":0,"ranged":1,"desc":"存活时间越长，攻击速度越快。"},{"k":"GemLizard","n":"宝石蜥蜴","type":"Summon","race":"僵尸","voc":"射手","q":1,"ranged":1,"desc":"电力充能，全面升级。"},{"k":"EagleBeakedArcher","n":"鹰喙弓手","type":"Summon","race":"僵尸","voc":"射手","q":0,"ranged":1,"desc":"拥有弹射攻击。"},{"k":"CatapultArcher","n":"投石弓手","type":"Summon","race":"僵尸","voc":"祭司","q":2,"ranged":1,"desc":"拥有能使敌人受到更多技能伤害的弹射攻击。"},{"k":"AngelArcher","n":"天使弓手","type":"Summon","race":"僵尸","voc":"射手","q":2,"ranged":1,"desc":"拥有能点燃被标记目标的弹射攻击。"},{"k":"FlyingEagle","n":"飞鹰","type":"Summon","race":"僵尸","voc":"商人","q":0,"ranged":0,"desc":"飞行单位。以阵风攻击敌人。"},{"k":"BlueDragon","n":"蓝龙","type":"Summon","race":"僵尸","voc":"法师","q":2,"ranged":0,"desc":"飞行单位。能周期性电击敌人。"},{"k":"IroncladWarrior","n":"铁甲战士","type":"Summon","race":"僵尸","voc":"先锋","q":1,"ranged":0,"desc":"重装单位。能以下一波之后虚弱一波的代价发动硬化，在下一波中提高伤害抗性。"},{"k":"SteelWarlord","n":"钢铁军阀","type":"Summon","race":"僵尸","voc":"先锋","q":3,"ranged":0,"desc":"使用金属包裹自身进一步提升坦度。"},{"k":"MoonlightApostle","n":"月光使徒","type":"Summon","race":"僵尸","voc":"法师","q":2,"ranged":1,"desc":"能周期性对单个目标造成大量伤害。"},{"k":"TimeMage","n":"时间法师","type":"Summon","race":"僵尸","voc":"祭司","q":3,"ranged":1,"desc":"光环单位。临近建造的单位法力恢复加快"},{"k":"RedDragon","n":"赤龙","type":"Summon","race":"僵尸","voc":"先锋","q":2,"ranged":0,"desc":"使用法力值抵挡受到的伤害，并且根据已失去法力值增加伤害。"},{"k":"BlackDragon","n":"黑龙","type":"Summon","race":"僵尸","voc":"先锋","q":3,"ranged":0,"desc":"飞行单位。传说中的生物，拥有更强大的法力护盾。"},{"k":"Pikeman","n":"长枪兵","type":"Summon","race":"科技","voc":"先锋","q":0,"ranged":0,"desc":"飞行单位。能用黄金增强其在下一波的战斗力"},{"k":"ChainmailPikeman","n":"链甲枪兵","type":"Summon","race":"科技","voc":"先锋","q":1,"ranged":0,"desc":"不再是飞行单位。综合性能更强的战斗装甲"},{"k":"MageApprentice","n":"见习法师","type":"Summon","race":"科技","voc":"法师","q":0,"ranged":1,"desc":"远程单位。拥有两条迥然不同的升级路线"},{"k":"CelestialMage","n":"天界法师","type":"Summon","race":"科技","voc":"法师","q":2,"ranged":1,"desc":"超远程狙击单位。每隔几次攻击就会释放闪电弹"},{"k":"FlameMage","n":"火焰法师","type":"Summon","race":"科技","voc":"射手","q":2,"ranged":1,"desc":"拥有能造成溅射伤害的火焰喷射器。"},{"k":"Bat","n":"机枪蝠","type":"Summon","race":"科技","voc":"射手","q":1,"ranged":1,"desc":"飞行单位。拥有一个随机攻击地面单位的机枪手。"},{"k":"VampireBat","n":"吸血蝠","type":"Summon","race":"科技","voc":"祭司","q":2,"ranged":1,"desc":"飞行光环单位。使临近建造的飞行单位获得伤害增幅。"},{"k":"Wizard","n":"巫师","type":"Summon","race":"科技","voc":"祭司","q":1,"ranged":1,"desc":"光环单位。临近建造的单位获得攻击速度加成。"},{"k":"Supervisor","n":"监工","type":"Summon","race":"科技","voc":"祭司","q":3,"ranged":1,"desc":"光环单位。使临近建造的单位能获得更多的攻击速度。"},{"k":"Gladiator","n":"角斗士","type":"Summon","race":"科技","voc":"战士","q":2,"ranged":0,"desc":"防御型单位。但是拥有对单个单位逐渐提升伤害的它对首领单位十分有效。"},{"k":"Berserker","n":"狂战士","type":"Summon","race":"科技","voc":"战士","q":3,"ranged":0,"desc":"能量战刃使其拥有逐渐增强的攻击。"},{"k":"GoldenDragon","n":"金龙","type":"Summon","race":"科技","voc":"射手","q":2,"ranged":1,"desc":"击杀敌人时会使他们爆炸。"},{"k":"MagicDragon","n":"魔龙","type":"Summon","race":"科技","voc":"射手","q":3,"ranged":1,"desc":"昂贵的造价带来的是无可匹敌的力量。"},{"k":"DesertArcher","n":"沙漠弓手","type":"Summon","race":"恶魔","voc":"射手","q":0,"ranged":1,"desc":"远程单位。能同时攻击三个敌人。"},{"k":"FantasyShooter","n":"幻影射手","type":"Summon","race":"恶魔","voc":"射手","q":1,"ranged":1,"desc":"崭新的面具为她带来了更加强大的力量"},{"k":"BlazingShooter","n":"烈焰射手","type":"Summon","race":"恶魔","voc":"射手","q":2,"ranged":1,"desc":"脾气十分的古怪。在强弱两种形态间互相切换。"},{"k":"Spider","n":"魂蛛","type":"Summon","race":"恶魔","voc":"战士","q":0,"ranged":0,"desc":"能主动发动灵魂祭品来永久提升它的数值。"},{"k":"FirePig","n":"火猪","type":"Summon","race":"恶魔","voc":"战士","q":0,"ranged":0,"desc":"能使用黄金在下一波中装备手里剑强化其攻击。"},{"k":"WhiteFang","n":"白牙","type":"Summon","race":"恶魔","voc":"战士","q":2,"ranged":0,"desc":"投掷手里剑的频率提升为之前的三倍。"},{"k":"AncestorWarrior","n":"先祖战士","type":"Summon","race":"恶魔","voc":"先锋","q":1,"ranged":0,"desc":"能死后复生的单位。"},{"k":"SoulWarrior","n":"灵魂战士","type":"Summon","race":"恶魔","voc":"先锋","q":3,"ranged":0,"desc":"手持传说之剑，身披赤色甲胄。能死后复生。"},{"k":"WhiteWolf","n":"白狼","type":"Summon","race":"恶魔","voc":"先锋","q":2,"ranged":0,"desc":"能冻缓周围单位并且出人意料为防御型的单位。"},{"k":"SnowWolfKing","n":"雪狼王","type":"Summon","race":"恶魔","voc":"先锋","q":3,"ranged":0,"desc":"能冻缓周围单位并且出人意料为防御型的单位。"},{"k":"SpiritSummonTower","n":"灵召塔","type":"Summon","race":"恶魔","voc":"法师","q":2,"ranged":2,"desc":"独特单位。无法移动或攻击，但是能召唤单位。"},{"k":"HellSummonTower","n":"地狱召唤塔","type":"Summon","race":"恶魔","voc":"法师","q":3,"ranged":2,"desc":"能召唤更强的召唤物"},{"k":"WildMage","n":"野法师","type":"Summon","race":"自然","voc":"战士","q":0,"ranged":0,"desc":"能造成溅射伤害，其真正的力量隐藏于升级之后的形态。"},{"k":"CannonFodderMage","n":"炮灰法师","type":"Summon","race":"自然","voc":"商人","q":1,"ranged":1,"desc":"其神秘的球茎在死亡时能产出少量的秘晶。"},{"k":"MageHero","n":"法师英雄","type":"Summon","race":"自然","voc":"射手","q":2,"ranged":1,"desc":"全盛形态，在波次中存活能变得更加强大。"},{"k":"WildManPriest","n":"野人祭司","type":"Summon","race":"自然","voc":"战士","q":0,"ranged":0,"desc":"死亡时，留下一个弱化的自己。"},{"k":"WildManKing","n":"野人王","type":"Summon","race":"自然","voc":"法师","q":2,"ranged":0,"desc":"死亡时生成一个史莱姆幼体。如果进行了长时间的战斗，可以多生成一个史莱姆幼体。"},{"k":"GreenDragon","n":"青龙","type":"Summon","race":"自然","voc":"祭司","q":1,"ranged":1,"desc":"以自身的生命力为代价治疗友军。"},{"k":"SkyDragon","n":"天龙","type":"Summon","race":"自然","voc":"祭司","q":2,"ranged":1,"desc":"拥有着通过多年的虔诚奉献而磨练出的强大能力。"},{"k":"CursedSwordsman","n":"诅咒剑士","type":"Summon","race":"自然","voc":"祭司","q":1,"ranged":0,"desc":"重装型单位。间隙性散射出诅咒之剑，造成范围伤害。"},{"k":"AgonyShieldDefender","n":"苦痛盾卫","type":"Summon","race":"自然","voc":"祭司","q":2,"ranged":0,"desc":"猩红之刃穿透了她的身躯，带走了逃出的希望。"},{"k":"DemonKingsGuard","n":"魔王近卫","type":"Summon","race":"自然","voc":"祭司","q":2,"ranged":0,"desc":"当痛苦无法逃避，唯一的选择就是接纳它"},{"k":"ChargeTower","n":"充能塔","type":"Summon","race":"自然","voc":"商人","q":2,"ranged":1,"desc":"无法移动。射程很远。"},{"k":"FireGodTower","n":"火神塔","type":"Summon","race":"自然","voc":"商人","q":3,"ranged":1,"desc":"从零重新设计过的双联装炮在保持了射速的情况下杀伤更强。"},{"k":"ShadowSwordsman","n":"影剑士","type":"Summon","race":"自然","voc":"战士","q":2,"ranged":0,"desc":"每次攻击时有几率复制自己。"},{"k":"ShadowKnight","n":"影骑士","type":"Summon","race":"自然","voc":"战士","q":3,"ranged":0,"desc":"使用一柄可以斩断现实之织的巨剑"},{"k":"BlackSword","n":"黑剑","type":"Summon","race":"虚空","voc":"祭司","q":0,"ranged":0,"desc":"最好是成群结队地作战，而不是单打独斗。当多个嚎狼／阳牙攻击同一个目标时，会造成更多的伤害。"},{"k":"DarkFang","n":"暗牙","type":"Summon","race":"虚空","voc":"祭司","q":2,"ranged":0,"desc":"它的金色皮毛标志着它是最凶猛的掠食者。当多个嚎狼／阳牙攻击同一个目标时，会造成更多的伤害。"},{"k":"PolarBear","n":"北极熊","type":"Summon","race":"虚空","voc":"战士","q":1,"ranged":0,"desc":"建造后获得额外属性，在之后的几波中慢慢失去该加成。"},{"k":"LifeTree","n":"生命树","type":"Summon","race":"虚空","voc":"祭司","q":2,"ranged":0,"desc":"为建造于其后方的单位恢复生命值。"},{"k":"BlackBear","n":"黑熊","type":"Summon","race":"虚空","voc":"战士","q":2,"ranged":0,"desc":"死亡时或者满能量时，对所有攻击过它的单位造成爆发伤害。"},{"k":"Landlord","n":"地主","type":"Summon","race":"虚空","voc":"商人","q":1,"ranged":1,"desc":"每波存活后都会获得越来越多的额外积分，但若它死亡，奖励会大幅度下降。"},{"k":"GoldenHand","n":"金手","type":"Summon","race":"虚空","voc":"商人","q":2,"ranged":1,"desc":"凭借大胆的新投资策略，它有着更大的盈利。。。和亏损潜力。"},{"k":"VikingPirate","n":"维京海盗","type":"Summon","race":"虚空","voc":"商人","q":0,"ranged":0,"desc":"拥有秘密贮藏，可以以更高的百分比价格出售。属性更低。"},{"k":"ShadowGrimReaper","n":"暗影死神","type":"Summon","race":"虚空","voc":"战士","q":2,"ranged":0,"desc":"不再拥有秘密贮藏，但是其属性大幅提升。"},{"k":"CrabWarlock","n":"蟹术士","type":"Summon","race":"虚空","voc":"法师","q":1,"ranged":1,"desc":"召唤一只小螃蟹来做它的脏活。"},{"k":"Crabomancer","n":"蟹巫","type":"Summon","race":"虚空","voc":"法师","q":3,"ranged":1,"desc":"现在召唤一只致命的蟹钳来战斗。"},{"k":"Pulsebot","n":"脉冲机器人","type":"Summon","race":"虚空","voc":"祭司","q":2,"ranged":0,"desc":"每次攻击都会释放一道冲击波，造成额外的范围伤害，并对敌方防御施加减益效果。"},{"k":"Skybot","n":"天空机器人","type":"Summon","race":"虚空","voc":"祭司","q":3,"ranged":0,"desc":"飞行单位。专为战斗而设计，其力量的增长与其升级后AI的凶猛程度相匹配。现在施加3层减益效果。"},{"k":"GoblinCopter","n":"哥布林直升机","type":"Summon","race":"虚空","voc":"商人","q":0,"ranged":1,"desc":"飞行单位。用双联炮攻击敌人。"},{"k":"Whirlybird","n":"旋翼机","type":"Summon","race":"虚空","voc":"射手","q":1,"ranged":1,"desc":"飞行单位。抛弃了它那无力的双联炮，换上了一门巨大的火箭发射器。每隔几次攻击就造成额外伤害。"},{"k":"WarpWing","n":"曲速之翼","type":"Summon","race":"虚空","voc":"祭司","q":1,"ranged":1,"desc":"飞行单位。降低其目标的攻击伤害。"},{"k":"VoidManta","n":"虚空魔鬼鱼","type":"Summon","race":"虚空","voc":"祭司","q":3,"ranged":1,"desc":"现在每次弹射都会施加多层等离子衰减。"},{"k":"Annihilator","n":"歼灭者","type":"Summon","race":"虚空","voc":"法师","q":2,"ranged":1,"desc":"维克特拉的独特单位。"},{"k":"GigaAnnihilator","n":"巨型歼灭者","type":"Summon","race":"虚空","voc":"法师","q":3,"ranged":1,"desc":"维克特拉的独特单位。"},{"k":"CrawlingCatapult","n":"爬行投石车","type":"Summon","race":"虚空","voc":"射手","q":2,"ranged":1,